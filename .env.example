# Reference environment for the 2 Free API.
#
#   cp .env.example .env
#
# Every value below is a placeholder, and two of them are placeholders the
# application actively refuses: BETTER_AUTH_SECRET rejects anything matching
# "replace me", and DATA_ENCRYPTION_KEY must decode to exactly 32 bytes. Both
# were checked against the validators rather than assumed — "REPLACE_WITH_..."
# passes the secret check, "REPLACE_ME_..." does not. An example secret that
# starts the process is an example secret that reaches a server.
#
# Nothing in this file is read in the cluster. There, every value arrives from a
# Secret referenced by the Deployment; this file exists for a laptop.

# Build identity reported by GET /version.
APP_VERSION=0.1.0
BUILD_SHA=local
APP_PROFILE=compose-cloud-dev

# PostgreSQL. The migrate image and the API read the same URL.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# 0.0.0.0 is required inside a container: a process bound to 127.0.0.1 in a pod
# is unreachable from the kubelet's probes and from the Service.
API_HOST=0.0.0.0
API_PORT=8080
FINANCE_BOUNDARY_LOCKED=true

# At least 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=REPLACE_ME_WITH_OPENSSL_RAND_BASE64_48
BETTER_AUTH_URL=http://localhost:8080

# Exact origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AES-256-GCM key: base64 of exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# Rotating this key over existing rows makes those rows undecryptable.
DATA_ENCRYPTION_KEY=REPLACE_ME_WITH_BASE64_OF_32_RANDOM_BYTES

# seed/reset stay absent (404) unless this is a disposable local database.
ENABLE_DESTRUCTIVE_DEVELOPMENT_ROUTES=false

# Optional pg_dump taken and verified before the migrate image touches the
# schema. pg_dump and pg_restore ship in that image; the path has to be writable
# by it, which in the cluster means a mounted volume rather than the read-only
# root filesystem.
# ROLLBACK_SNAPSHOT_PATH=/var/backups/twofree/pre-migration.dump
